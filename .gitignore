tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~

# Keep the parsed desktop bundle resources in Git.
# package.json starts from out/main/index.js, so do not ignore:
# out/, build/, bundled-agents/, bundled-resources/, bundled-tools/, tools/,
# glm/, and model-providers/.
